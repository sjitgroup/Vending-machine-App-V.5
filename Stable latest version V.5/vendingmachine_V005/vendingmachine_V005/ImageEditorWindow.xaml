<Window x:Class="vendingmachine_V005.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="고급 벡터 디자인 편집기 (우클릭 메뉴 &amp; 텍스트 지원)" Height="750" Width="1100"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F4F4F4" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- 상단 툴바 -->
        <DockPanel Grid.Row="0" Background="White" LastChildFill="False" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="🎨 벡터 디자인 편집기" FontSize="18" FontWeight="Bold" Foreground="#8E44AD" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <Button Content="⬛ 사각형" Click="BtnAddRect_Click" Width="80" Height="32" Margin="3,0" Background="#34495E" Foreground="White" FontWeight="Bold"/>
                <Button Content="⚪ 원" Click="BtnAddEllipse_Click" Width="70" Height="32" Margin="3,0" Background="#34495E" Foreground="White" FontWeight="Bold"/>
                <Button Content="🖼️ 이미지" Click="BtnAddImage_Click" Width="90" Height="32" Margin="3,0" Background="#2980B9" Foreground="White" FontWeight="Bold"/>
                <Button Content="🔤 텍스트" Click="BtnAddText_Click" Width="90" Height="32" Margin="3,0" Background="#9B59B6" Foreground="White" FontWeight="Bold"/>
                <Button Content="🗑️ 선택 삭제" Click="BtnDeleteSelected_Click" Width="100" Height="32" Margin="10,0,0,0" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock x:Name="txtEditingProductName" Text="대상 상품: 없음" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="10,0"/>
        </DockPanel>

        <!-- 메인 작업 영역 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 디자인 캔버스 영역 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="DesignCanvas" Width="800" Height="600" Background="White" MouseLeftButtonDown="Canvas_MouseLeftButtonDown"/>
                </ScrollViewer>
            </Border>

            <!-- 우측 속성 패널 -->
            <Border Grid.Column="1" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="8" Margin="10,0,0,0" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="⚙️ 속성 조절" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <TextBlock Text="💡 팁1: 요소 우측 하단 드래그 = 크기 조절" FontSize="12" Foreground="#16A085" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <TextBlock Text="💡 팁2: 요소 마우스 우클릭 = 색상/폰트 변경" FontSize="12" Foreground="#D35400" TextWrapping="Wrap" Margin="0,0,0,15"/>
                        <TextBlock x:Name="txtSelectedInfo" Text="캔버스에서 요소를 선택하세요." FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,15" TextWrapping="Wrap"/>

                        <StackPanel x:Name="PropertyPanel" IsEnabled="False">

                            <!-- 텍스트 전용 속성 -->
                            <StackPanel x:Name="TextPropertyPanel" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock Text="텍스트 내용" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtTextContent" Height="30" TextChanged="TextProperty_TextChanged" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                <TextBlock Text="글자 크기 (직접입력)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtFontSize" Height="30" TextChanged="TextProperty_TextChanged" Margin="0,0,0,5" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- 공통 속성 -->
                            <TextBlock Text="가로 크기 (Width)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtWidth" Height="30" TextChanged="Property_TextChanged" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                            <TextBlock Text="세로 크기 (Height)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtHeight" Height="30" TextChanged="Property_TextChanged" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                            <TextBlock Text="X 좌표 (Left)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtLeft" Height="30" TextChanged="Property_TextChanged" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                            <TextBlock Text="Y 좌표 (Top)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtTop" Height="30" TextChanged="Property_TextChanged" Margin="0,0,0,15" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="적용 및 저장" Click="BtnSaveDesign_Click" Width="140" Height="42" Margin="0,0,10,0" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="15"/>
            <Button Content="취소" Click="BtnCloseEditor_Click" Width="100" Height="42" Background="#7F8C8D" Foreground="White" FontWeight="Bold" FontSize="15"/>
        </StackPanel>
    </Grid>
</Window>