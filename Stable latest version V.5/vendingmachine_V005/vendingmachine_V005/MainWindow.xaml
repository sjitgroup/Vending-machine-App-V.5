<Window x:Class="vendingmachine_V005.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="스마트 자판기 시스템 V.6" Height="780" Width="1024"
        KeyDown="Window_KeyDown" Background="#FFF5F6FA" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <!-- [손님용 메인 화면] -->
        <Grid x:Name="CustomerPanel" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- 상단 헤더 -->
            <Border Grid.Row="0" Background="#FF2C3E50" Padding="20,0">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="images/sjitgrouplogo.png" Height="52" Margin="0,0,12,0" Stretch="Uniform" Width="120"/>
                        <TextBlock x:Name="AppTitleText" Text="스마트 자판기 시스템 V.6" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌐 언어 / Language:" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="LanguageSelector" Width="110" Height="30" Margin="0,0,15,0" Foreground="Black" Background="White" SelectionChanged="LanguageSelector_SelectionChanged">
                            <ComboBoxItem Content="한국어 (KO)" Foreground="Black"/>
                            <ComboBoxItem Content="English (EN)" Foreground="Black"/>
                            <ComboBoxItem Content="힌디어 (HI)" Foreground="Black"/>
                            <ComboBoxItem Content="日本語 (JA)" Foreground="Black"/>
                        </ComboBox>
                        <TextBlock x:Name="SystemStatusText" Text="🔴 비정상 작동 중 (F12 관리자 로그인)" Foreground="#FFFF6B6B" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 중앙 상품 목록 영역 -->
            <Grid Grid.Row="1" Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ProductListTitleText" Grid.Row="0" Text="판매 상품 목록" FontSize="18" FontWeight="Bold" Foreground="#FF2C3E50" Margin="0,0,0,15"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CustomerProductItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="210" Height="310" Background="White" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,20,20" Padding="15">
                                    <StackPanel VerticalAlignment="Center">
                                        <Image Source="{Binding ImagePath}" Height="90" Width="90" Stretch="Uniform" Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="#FF000000"/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N0}원}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="#FFE74C3C"/>
                                        <TextBlock Text="{Binding Stock, StringFormat=남은수량: {0}개}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#FF555555"/>
                                        <Button Content="장바구니 담기" Height="38" Background="#FF3498DB" Foreground="White" FontWeight="Bold" FontSize="13" Click="AddToCart_Click" Tag="{Binding Name}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 하단 장바구니 요약 및 결제 바 -->
            <Border Grid.Row="2" Background="White" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="25,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="CartSummaryText" Text="장바구니 담긴 상품: 0개 (0원)" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FF2C3E50"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ViewCartButton" Content="장바구니 보기" Width="120" Height="40" Background="#FF1ABC9C" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,10,0" Click="ViewCart_Click"/>
                        <Button x:Name="CheckoutButton" Content="결제하기" Width="120" Height="40" Background="#FF2ECC71" Foreground="White" FontWeight="Bold" FontSize="13" Click="Checkout_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- [관리자 대시보드 화면] -->
        <Grid x:Name="AdminPanel" Visibility="Collapsed" Background="#FF1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF2D2D30" Padding="20,0">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="images/sjitgrouplogo.png" Height="52" Margin="0,0,12,0" Stretch="Uniform" Width="120"/>
                        <TextBlock Text="자판기 통합 관리 시스템 (관리자 모드)" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="손님 화면으로 복귀" Width="140" Height="35" Background="#FFE74C3C" Foreground="White" FontWeight="Bold" Click="AdminLogout_Click" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <TabControl Grid.Row="1" Background="#FF1E1E1E" Foreground="White" BorderThickness="0" Margin="10">

                <!-- 1. 상품 및 하드웨어 탭 -->
                <TabItem Header="상품 및 하드웨어" FontSize="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                        <StackPanel>
                            <Border Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="➕ 신규 판매 상품 등록 (서보당 재고 1개)" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="상품명 (영문 필수)" Foreground="White" Margin="0,0,0,3"/>
                                            <TextBox x:Name="InputProdNameBox" Height="30" VerticalContentAlignment="Center" Background="White" Foreground="Black"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="가격 (원)" Foreground="White" Margin="0,0,0,3"/>
                                            <TextBox x:Name="InputProdPriceBox" Height="30" VerticalContentAlignment="Center" Background="White" Foreground="Black"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="서보 핀 번호 (예: 9, 10, 11)" Foreground="White" Margin="0,0,0,3"/>
                                            <TextBox x:Name="InputProdServoBox" Height="30" VerticalContentAlignment="Center" Background="White" Foreground="Black"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="서보 회전 방향 설정" Foreground="White" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="InputProdDirectionCombo" Height="30" SelectedIndex="0" Foreground="Black" Background="White">
                                                <ComboBoxItem Content="시계 방향 (CW)"/>
                                                <ComboBoxItem Content="반시계 방향 (CCW)"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="상품 이미지 선택 (.png, .jpg)" Foreground="White" Margin="0,0,0,3"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="InputProdImageBox" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Background="White" Foreground="Black" IsReadOnly="True"/>
                                                <Button Grid.Column="1" Content="파일 찾기" Height="30" Margin="5,0,0,0" Background="#FF007ACC" Foreground="White" FontWeight="Bold" Click="BrowseProductImage_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Button Content="상품 등록하기" Height="38" Background="#FF2ECC71" Foreground="White" FontWeight="Bold" FontSize="14" Click="RegisterNewProduct_Click" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="📦 판매 상품 재고 목록" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                    <DataGrid x:Name="AdminProductGrid" AutoGenerateColumns="False" Height="150" CanUserAddRows="False" CanUserDeleteRows="False" Background="White" Foreground="Black" RowBackground="White" AlternatingRowBackground="#FFF0F0F0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="상품명" Width="140" Binding="{Binding Name}"/>
                                            <DataGridTextColumn Header="가격(원)" Width="100" Binding="{Binding Price}"/>
                                            <DataGridTextColumn Header="재고" Width="70" Binding="{Binding Stock}"/>
                                            <DataGridTextColumn Header="서보 핀" Width="80" Binding="{Binding ServoChannel}"/>
                                            <DataGridTextColumn Header="회전방향" Width="90" Binding="{Binding RotationDirection}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="🔌 아두이노 메가 2560 포트 연결" FontSize="16" FontWeight="Bold" Foreground="#2ECC71" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox x:Name="PortComboBox" Width="120" Height="30" Margin="0,0,10,0" SelectedIndex="0" Foreground="Black" Background="White"/>
                                            <Button Content="연결" Width="80" Height="30" Background="#2ECC71" Foreground="White" FontWeight="Bold" Click="ArduinoConnect_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="6" Padding="15" Margin="10,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ 서보 모터 직접 제어" FontSize="16" FontWeight="Bold" Foreground="#F39C12" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="핀:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <ComboBox x:Name="ServoPinSelector" Width="80" Height="30" SelectedIndex="0" Foreground="Black" Background="White" Margin="0,0,10,0"/>
                                            <TextBlock Text="방향:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <ComboBox x:Name="ServoDirectionSelector" Width="95" Height="30" SelectedIndex="0" Foreground="Black" Background="White">
                                                <ComboBoxItem Content="시계(CW)"/>
                                                <ComboBoxItem Content="반시계(CCW)"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <primitives:UniformGrid Columns="2" Rows="1">
                                            <Button Content="바로 돌리기" Height="30" Background="#E67E22" Foreground="White" FontWeight="Bold" Margin="3" Click="ServoRun_Click"/>
                                            <Button Content="0도 맞추기" Height="30" Background="#3498DB" Foreground="White" FontWeight="Bold" Margin="3" Click="ServoZero_Click"/>
                                        </primitives:UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 2. 카드 등록 및 관리 탭 -->
                <TabItem Header="카드 등록 및 관리" FontSize="14" Loaded="CardTab_Loaded">
                    <Grid Margin="20" Background="#FF1E1E1E">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#FF2D2D30" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📡" FontSize="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="실물 RFID 리더기 대기 상태" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="리더기에 카드를 태깅하면 아래 입력란에 즉시 반영됩니다." FontSize="12" Foreground="#FF858585" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="➕ 신규 사용자 카드 등록" FontSize="16" FontWeight="Bold" Foreground="#FF4EC9B0" Margin="0,0,0,15"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="사용자 이름" Foreground="#FFCCCCCC" Margin="0,0,0,5"/>
                                        <TextBox x:Name="InputUserNameBox" Height="35" VerticalContentAlignment="Center" Background="#FF333337" Foreground="White" BorderBrush="#FF3F3F46"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="카드 번호 (7자리)" Foreground="#FFCCCCCC" Margin="0,0,0,5"/>
                                        <TextBox x:Name="InputCardNumberBox" Height="35" MaxLength="7" VerticalContentAlignment="Center" Background="#FF333337" Foreground="White" BorderBrush="#FF3F3F46"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="카드 PIN (3자리 비밀번호)" Foreground="#FFCCCCCC" Margin="0,0,0,5"/>
                                        <PasswordBox x:Name="InputCardPinBox" Height="35" MaxLength="3" VerticalContentAlignment="Center" Background="#FF333337" Foreground="White" BorderBrush="#FF3F3F46"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="RFID 고유 값 (태깅 시 자동 입력)" Foreground="#FFCCCCCC" Margin="0,0,0,5"/>
                                        <TextBox x:Name="InputRfidBox" Height="35" VerticalContentAlignment="Center" Background="#FF1E1E1E" Foreground="#FF569CD6" FontWeight="Bold" BorderBrush="#FF3F3F46" IsReadOnly="True"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="카드 등록하기" Height="40" Background="#FF007ACC" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,20,0,0" Click="RegisterNewCard_Click"/>
                            </StackPanel>
                        </Border>
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Text="📋 시스템에 등록된 사용자 카드 목록" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                            <DataGrid x:Name="RegisteredCardGrid" AutoGenerateColumns="False" CanUserAddRows="False" Background="#FF252526" Foreground="White" RowBackground="#FF2D2D30" AlternatingRowBackground="#FF252526" BorderBrush="#FF3F3F46">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="카드 PIN" Width="70" Binding="{Binding CardPin}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="RFID 값" Width="150" Binding="{Binding RfidValue}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="카드번호" Width="110" Binding="{Binding CardNumber}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="사용자 이름" Width="*" Binding="{Binding UserName}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="잔액" Width="110" Binding="{Binding Balance, StringFormat={}{0:N0}원}" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="관리" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="수정" Width="40" Margin="0,0,5,0" Background="#FF007ACC" Foreground="White" Click="EditCard_Click" Tag="{Binding}"/>
                                                    <Button Content="삭제" Width="40" Background="#FFE51400" Foreground="White" Click="DeleteCard_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- 3. Wi-Fi 네트워크 탭 -->
                <TabItem Header="Wi-Fi 네트워크" FontSize="14">
                    <Grid Background="#FF0F1319" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="유형" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="동작" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="네트워크 이름" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="대역" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="네트워크 강도" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="상태" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <ListView x:Name="WifiListView" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid Width="880">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TypeIcon}" FontSize="20" Foreground="#FF3498DB" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="{Binding ActionText}" Width="70" Height="30" Foreground="White" FontWeight="Bold" Background="{Binding ButtonColor}" BorderThickness="0" Cursor="Hand" Click="WifiAction_Click" Tag="{Binding Ssid}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Ssid}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Band}" Foreground="#BDC3C7" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <Grid Grid.Column="4" Margin="0,0,20,0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Score}" Foreground="{Binding BarColor}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <ProgressBar Grid.Column="1" Value="{Binding Score}" Minimum="0" Maximum="100" Height="12" Foreground="{Binding BarColor}" Background="#FF2C3E50" BorderThickness="0"/>
                                            </Grid>
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🔒" FontSize="16" Foreground="#FF3498DB" Margin="2,0" Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="🔑" FontSize="16" Foreground="#FF3498DB" Margin="2,0" Visibility="{Binding HasKey, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- 4. 아두이노 소스 및 가이드 탭 -->
                <TabItem Header="아두이노 소스 및 가이드" FontSize="14">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="RC522, 서보 통합 아두이노 스케치" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" x:Name="ArduinoCodeBox" AcceptsReturn="True" TextWrapping="Wrap" Background="#FF1E1E1E" Foreground="#FF9CDCFE" FontFamily="Consolas" FontSize="12" IsReadOnly="True" Padding="10"/>
                            <Button Grid.Row="2" Content="아두이노 코드 클립보드 복사" Width="200" Height="38" Background="#FF007ACC" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,10,0,0" Click="CopyArduinoCode_Click"/>
                        </Grid>
                        <Border Grid.Column="1" Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="6" Padding="15">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="📦 필수 설치 라이브러리" FontSize="15" FontWeight="Bold" Foreground="#2ECC71" Margin="0,0,0,8"/>
                                    <TextBox Text="1. MFRC522&#x0a;2. Servo" Background="#FF1E1E1E" Foreground="White" FontSize="12" IsReadOnly="True" Padding="8" Margin="0,0,0,15"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 5. 경로 및 백업 설정 탭 -->
                <TabItem Header="경로 및 백업 설정" FontSize="14">
                    <Grid Margin="20" Background="#FF1E1E1E">
                        <StackPanel Width="500" HorizontalAlignment="Left">
                            <TextBlock Text="📁 사용자 카드 등록 폴더 설정" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CardFolderPathBox" Grid.Column="0" Height="35" FontSize="13" VerticalContentAlignment="Center" IsReadOnly="True" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="폴더 찾기" Height="35" Background="#FF007ACC" Foreground="White" FontWeight="Bold" Click="BrowseCardFolder_Click"/>
                            </Grid>
                            <TextBlock Text="📂 sjvmst 파일 저장 위치 설정" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SjvmstPathBox" Grid.Column="0" Height="35" FontSize="13" VerticalContentAlignment="Center" IsReadOnly="True" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="폴더 찾기" Height="35" Background="#FF007ACC" Foreground="White" FontWeight="Bold" Click="BrowseSjvmstFolder_Click"/>
                            </Grid>
                            <Button Content="설정 저장 및 자동 백업 실행 (sjvmst 생성)" Height="45" Background="#FF2ECC71" Foreground="White" FontWeight="Bold" FontSize="14" Click="SaveSettingsAndBackup_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- 6. 영수증 출력기 탭 -->
                <TabItem Header="영수증 출력기" FontSize="14">
                    <Grid Margin="20" Background="#FF1E1E1E">
                        <StackPanel Width="500" HorizontalAlignment="Left">
                            <TextBlock Text="🖨️ 영수증 열전사 프린터 설정 및 테스트" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                            <TextBlock Text="출력기 시리얼/USB 포트 선택" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PrinterPortComboBox" Grid.Column="0" Height="35" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0" SelectedIndex="0">
                                    <ComboBoxItem Content="COM1"/>
                                </ComboBox>
                                <Button Grid.Column="1" Content="포트 연결" Height="35" Background="#FF007ACC" Foreground="White" FontWeight="Bold" Click="ConnectPrinter_Click"/>
                            </Grid>
                            <Button Content="테스트 영수증 강제 출력" Height="45" Background="#FF2ECC71" Foreground="White" FontWeight="Bold" FontSize="14" Click="PrintTestReceipt_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- 7. 디버그 및 시스템 탭 -->
                <TabItem Header="디버그 및 시스템" FontSize="14">
                    <StackPanel Margin="20">
                        <TextBlock Text="🛠 시스템 디버그 및 권한 제어" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                        <CheckBox x:Name="DebugModeCheck" Content="디버그 모드 활성화 (비밀번호 인증 필요)" Foreground="White" FontSize="14" Margin="0,0,0,15" Checked="DebugModeCheck_Checked" Unchecked="DebugModeCheck_Unchecked"/>
                        <Button Content="관리자 권한으로 재시작" Width="200" Height="38" Background="#FF3498DB" Foreground="White" FontWeight="Bold" HorizontalAlignment="Left" Click="RequestAdminPrivileges_Click"/>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>