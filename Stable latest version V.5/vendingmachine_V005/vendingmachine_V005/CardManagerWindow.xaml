<Window x:Class="vendingmachine_V005.CardManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="외부 카드 인증 에뮬레이터" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="💳 카드 태그 및 인증" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBox x:Name="CardNumberInput" Width="300" Height="35" FontSize="14" Margin="0,0,0,15" VerticalContentAlignment="Center" />
            <Button Content="카드 인증 승인" Click="RegisterCard_Click" Width="200" Height="40" FontSize="15" Background="#FFFF9800" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>